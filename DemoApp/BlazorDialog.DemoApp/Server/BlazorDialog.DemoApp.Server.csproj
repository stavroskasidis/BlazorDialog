<Project Sdk="Microsoft.NET.Sdk.Web">
	
  <ItemGroup>
     <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="$(MSPackagesVersion)" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Remove="ClientSources\**" />
    <Content Remove="ClientSources\**" />
    <None Include="ClientSources\**" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client\BlazorDialog.DemoApp.Client.csproj" />
    <ProjectReference Include="..\Shared\BlazorDialog.DemoApp.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ClientSources\" />
  </ItemGroup>

  <!-- Mirrors the client sources so the demo site can display them. Uses msbuild tasks instead of
       del/xcopy so that it also works when building on macOS/linux. -->
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <ItemGroup>
      <StaleClientSource Include="$(ProjectDir)ClientSources/**/*" />
      <ClientSource Include="$(ProjectDir)../Client/**/*.razor;$(ProjectDir)../Client/**/*.cs;$(ProjectDir)../Client/**/*.js"
                    Exclude="$(ProjectDir)../Client/bin/**;$(ProjectDir)../Client/obj/**" />
      <ClientStyleSource Include="$(ProjectDir)../Client/wwwroot/**/*.css" />
    </ItemGroup>
    <Delete Files="@(StaleClientSource)" />
    <Copy SourceFiles="@(ClientSource)"
          DestinationFiles="@(ClientSource->'$(ProjectDir)ClientSources/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(ClientStyleSource)"
          DestinationFiles="@(ClientStyleSource->'$(ProjectDir)ClientSources/wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
